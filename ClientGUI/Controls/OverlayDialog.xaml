<!--
    页面内浮层宿主（v2.5.0）：遮罩 + 居中卡片 + 通栏主 / 次按钮。

    为什么不用 MessageBox：
      · 系统模态框不是页面内浮层，移植到手机端时得重写一遍（PRD 移植友好度 C11）；
      · 业务流程（彩蛋 / 服务器设置 / 改密码）需要「就地提示 + 保留已输入内容」，弹框做不到。

    为什么不是 Window 子类：ClientGUI.Tests 的界面冒烟会按类名与构造签名实例化一批窗口，
    新增 Window 子类会扩大这份「结构契约」；用 UserControl 浮层则完全不触碰它（架构 D3-C2）。

    用法（代码里）：
        var dialog = new OverlayDialog();
        dialog.DialogTitle = "修改密码";
        dialog.DialogBody  = new ChangePasswordDialog();   // 任意 FrameworkElement
        dialog.PrimaryButtonText = "确定";
        dialog.PrimaryClick += (_, _) => ...;
        dialog.Message = "旧密码错误";   // 就地提示，不弹框
-->
<UserControl x:Class="ClientGUI.Controls.OverlayDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource MaskBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             IsVisibleChanged="OverlayDialog_OnIsVisibleChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 点击遮罩空白处 = 取消（与手机端「点遮罩关闭」一致）。 -->
    <Grid MouseLeftButtonDown="Mask_OnMouseLeftButtonDown">
        <Border Style="{StaticResource OverlayCard}" MouseLeftButtonDown="Card_OnMouseLeftButtonDown">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource OverlayTitle}" />

                <!-- 正文由使用方塞进来（任意 FrameworkElement）。 -->
                <ContentControl x:Name="BodyHost" Margin="0,16,0,0" />

                <!-- 就地提示：11px，写在按钮上方，不弹框。 -->
                <TextBlock x:Name="MessageText" Style="{StaticResource FieldError}" Margin="0,12,0,0"
                           Visibility="Collapsed" />

                <Button x:Name="PrimaryButton" Style="{StaticResource BlockPrimaryButton}"
                        Margin="0,16,0,0" Click="PrimaryButton_OnClick" />
                <Button x:Name="SecondaryButton" Style="{StaticResource BlockSecondaryButton}"
                        Margin="0,8,0,0" Click="SecondaryButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
