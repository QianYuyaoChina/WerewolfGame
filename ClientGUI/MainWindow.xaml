<Window x:Class="ClientGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        xmlns:views="clr-namespace:ClientGUI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GameViewModel}"
        Title="狼人杀 · 客户端"
        Height="780" Width="1220" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        KeyDown="MainWindow_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 用 pack URI 定位，保证从任意工作目录启动、或被其他宿主加载时都能解析。
                 Panels 内部已合并 Converters + Controls；颜色由 ThemeManager 挂在 Application 级。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 菜单栏 -->
            <RowDefinition Height="Auto" />  <!-- 标题栏 -->
            <RowDefinition Height="*" />     <!-- 主区域 -->
            <RowDefinition Height="Auto" />  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 菜单栏 ═══════════════ -->
        <!--
            常用功能集中于此：游戏（开始 / 退出房间 / 退出程序）、
            视图（三栏显隐 + 清空消息）、帮助（更新日志 / 关于）。
            面板显隐与打开子窗口属于“视图层”职责，用代码隐藏处理；
            真正的游戏动作（开始、退出房间、清空消息）仍走视图模型命令。
        -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Menu Style="{StaticResource FlatMenu}"
                  ItemContainerStyle="{StaticResource FlatMenuItem}">
                <MenuItem Header="游戏(_G)">
                    <MenuItem Header="开始游戏" InputGestureText="Ctrl+G"
                              Command="{Binding StartGameCommand}"
                              IsEnabled="{Binding CanStartGame}" />
                    <MenuItem Header="生成邀请码" InputGestureText="Ctrl+I"
                              Click="Menu_Invite_OnClick"
                              IsEnabled="{Binding HasRoomInfo}" />
                    <Separator Style="{StaticResource MenuSeparator}" />
                    <MenuItem Header="退出房间" Command="{Binding DisconnectCommand}"
                              IsEnabled="{Binding CanLeaveRoom}" />
                    <MenuItem Header="退出程序" InputGestureText="Ctrl+Q"
                              Click="Menu_Exit_OnClick" />
                </MenuItem>

                <MenuItem Header="视图(_V)">
                    <MenuItem x:Name="MenuTogglePlayers" Header="玩家列表"
                              IsCheckable="True" IsChecked="True" Click="Menu_TogglePanel_OnClick" />
                    <MenuItem x:Name="MenuToggleChat" Header="房间消息"
                              IsCheckable="True" IsChecked="True" Click="Menu_TogglePanel_OnClick" />
                    <MenuItem x:Name="MenuToggleActions" Header="操作面板"
                              IsCheckable="True" IsChecked="True" Click="Menu_TogglePanel_OnClick" />
                    <Separator Style="{StaticResource MenuSeparator}" />
                    <MenuItem Header="清空消息" InputGestureText="Ctrl+L"
                              Command="{Binding ClearLogCommand}" IsEnabled="{Binding HasLog}" />
                </MenuItem>

                <MenuItem Header="帮助(_H)">
                    <MenuItem Header="更新日志" Click="Menu_Changelog_OnClick" />
                    <MenuItem Header="关于" InputGestureText="F1" Click="Menu_About_OnClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ═══════════════ 标题栏 ═══════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="18,12"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐺" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="狼人杀" FontSize="17" FontWeight="Bold" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="客户端" FontSize="12" Margin="8,2,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <!--
                    右上角统一放「设置」类入口（不再分散到「游戏 / 视图」两个菜单里）：
                    · 设置：外观主题与主界面（Ctrl + ,）
                    · 房主设置：房间人数 / 密码 / 身份配置 / 邀请码（仅房主可用）
                    右侧的当前局势与「退出房间」只在进房后显示。
                -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button Content="⚙ 设置" Style="{StaticResource FlatButton}" Padding="12,6" Margin="0,0,8,0"
                            Click="Menu_Settings_OnClick" ToolTip="外观与主界面设置（快捷键 Ctrl + ,）" />
                    <Button Content="👑 房主设置" Style="{StaticResource FlatButton}" Padding="12,6" Margin="0,0,12,0"
                            Click="Menu_HostSettings_OnClick" IsEnabled="{Binding IsHost}"
                            ToolTip="房间人数 / 密码 / 身份配置 / 邀请码（仅房主）" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                            BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            Visibility="{Binding HasRoomInfo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding RoomHeaderText}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </Border>
                    <!-- 游戏自定义状态胶囊（阶段 / 天数 / 倒计时等）：由插槽面板 Game.Chips 提供 -->
                    <ItemsControl ItemsSource="{Binding Game.Chips}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatusChip}">
                                <Border Background="{DynamicResource ChipBrush}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="5" Padding="10,5" Margin="0,0,8,0"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <Button Content="退出房间" Style="{StaticResource FlatButton}" Padding="12,6"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding CanLeaveRoom}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ 主区域（三栏） ═══════════════ -->
        <Grid Grid.Row="2" Margin="14"
              Visibility="{Binding ShowGamePanel, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <!-- 列宽与面板可见性由「视图」菜单驱动（见 MainWindow.xaml.cs）。 -->
                <ColumnDefinition x:Name="PlayersColumn" Width="286" />
                <ColumnDefinition x:Name="ChatColumn" Width="*" />
                <ColumnDefinition x:Name="ActionsColumn" Width="308" />
            </Grid.ColumnDefinitions>

            <views:PlayerPanel x:Name="PlayersView" Grid.Column="0" />
            <views:ChatPanel x:Name="ChatView" Grid.Column="1" Margin="14,0" />
            <views:ActionPanel x:Name="ActionsView" Grid.Column="2" />
        </Grid>

        <!-- ═══════════════ 状态栏 ═══════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" Padding="16,7"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 连接指示灯 + 延迟：由视图模型按“已连接 / 重连中 / 未连接”给出配色与文案。 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" Foreground="{Binding ConnectionIndicatorBrush}"
                               Text="{Binding ConnectionIndicatorText}" />
                    <TextBlock FontSize="11.5" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding LatencyText}"
                               Visibility="{Binding HasLatency, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding LogStatus}" FontSize="11.5" Margin="16,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />

                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource FaintBrush}"
                           Text="{Binding VersionText}" ToolTip="客户端版本" />
            </Grid>
        </Border>
    </Grid>
</Window>
