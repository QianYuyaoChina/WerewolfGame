<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ═══════════════ 小程序页面骨架样式层（v2.5.0） ═══════════════

        本字典的语义是「页面怎么组织」，与 Controls.xaml（「控件长什么样」）分开演进；
        内部通过 BasedOn 复用 Controls.xaml 的基础样式，因此必须显式合并它。

        引用方式：**不需要**在窗口里改任何字典声明 —— 本字典由 Themes/Panels.xaml 合并，
        而全部窗口都已经合并了 Panels.xaml，加一行即全局生效（架构决策 D1）。

        ───────── 规范表（改样式前先看这里；WPF 没有 CSS 变量，只能靠这张表对齐） ─────────

        页面骨架：导航栏 56 → 内容区（灰底 PageBgBrush + 白色卡片 CardBrush）→ 底部操作条
        圆角阶梯：卡片 12 / 按钮 10 / 输入框 8 / 胶囊 999（全圆）—— 只允许这四档
        字号阶梯：导航标题 17 / 区块标题 15 / 正文 14 / 次要 12 / 脚注 11 —— 只允许这五档
        间距阶梯：4 / 8 / 12 / 16 / 24 —— 只允许这五档
        列表行：  高 ≥ 56，整行可点，分隔线 1px 且左缩进 16
        按钮：    主按钮通栏（高 48，圆角 10）；点击热区一律 ≥ 44
        输入框：  高 44，圆角 8，标签在框上方，错误提示就地 11px，不弹框

        颜色一律 {DynamicResource XxxBrush}；两套主题键名必须完全一致（由 AppShellGuard A1 守护）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════ 导航栏 ═══════════════ -->

    <!-- 页面顶部导航栏：高 56，左右槽位各 ≥44×44，槽位为空时不放占位按钮。 -->
    <Style x:Key="NavBarPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NavBarBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 导航标题：居中、17px、SemiBold。 -->
    <Style x:Key="NavTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource NavBarTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--
        导航标题按钮：既是标题又是热区（房间列表的彩蛋就挂在这里，见 K12）。
        透明底、无边框、内容居中、≥44×44，点上去不改变布局。
    -->
    <Style x:Key="NavTitleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource NavBarTextBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航栏左右槽位的图标 / 文字按钮：热区 44×44。 -->
    <Style x:Key="NavIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource NavBarTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ 内容区 ═══════════════ -->

    <!-- 可滚动的内容区（页面底色由窗口根元素给 PageBgBrush）。 -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 卡片：圆角 12、内边距 16、卡片间距 12、不描边。 -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 卡片内的次级区块 / 分组头。 -->
    <Style x:Key="CardSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 列表行：高 ≥56，整行可点（热区由外层的 ListBoxItem 模板铺满）。 -->
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 分隔线：1px，左缩进 16（与文字对齐，不顶格），最后一行不画。 -->
    <Style x:Key="DividerLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 底部操作条：主按钮通栏（左右 16、高 48、圆角 10）。 -->
    <Style x:Key="FooterBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource NavBarBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════ 按钮 ═══════════════ -->

    <!-- 通栏主按钮：一屏最多一个，颜色走语义键 Action*（主色沿用现有蓝，不引入微信绿）。 -->
    <Style x:Key="BlockPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ActionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionPressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActionDisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 通栏次按钮：描边样式，排在主按钮下方（不与主按钮并排挤在一角）。 -->
    <Style x:Key="BlockSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ 胶囊 ═══════════════ -->

    <!-- 通用胶囊（状态标签）：圆角 999，1px 描边。 -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 称号胶囊（金）：文字比相邻正文小一档（12），同色系圆角描边 + 极淡底。 -->
    <Style x:Key="TitleChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource TitleBgBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="TitleChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 状态胶囊（比通用胶囊多一层很淡的底，用于「运行中 / 未启动」这类实时状态）。 -->
    <Style x:Key="StatusChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════ 表单 ═══════════════ -->

    <!-- 标签在框上方；一行一个输入框。 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- 输入框：高 44、圆角 8（MinHeight 与圆角由 FlatTextBox 提供，这里只补字号与内边距）。 -->
    <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="FieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource FlatPasswordBox}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- 就地错误提示：11px，写在框下方，不弹框。 -->
    <Style x:Key="FieldError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- 占位 / 说明文字（输入框下方的弱提示，非错误）。 -->
    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- ═══════════════ 文字阶梯 ═══════════════ -->

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MinorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FootnoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ═══════════════ 浮层（替代 MessageBox 承载业务流程） ═══════════════ -->

    <Style x:Key="OverlayHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaskBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="OverlayCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="440" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="OverlayTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
