<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ═══════════════ 深色主题配色（默认） ═══════════════

        这是「颜色」的唯一来源：所有界面都必须用 {DynamicResource XxxBrush} 引用这里的键，
        不能写死 #RRGGBB，否则切换主题时不会更新。
        ThemeManager 在运行期把本字典整体换成 Colors.Light.xaml（键名完全一致），
        由于 DynamicResource 会重新求值，已打开的窗口会立刻跟着变。

        新增颜色时请同时在 Colors.Light.xaml 里加上同名键。

        v2.5.0 新增 17 个「语义键」：名字描述用途、不描述色相（详见 docs/v25/ARCHITECTURE.md §4.1）。
        其中 Action* 三兄弟的取值**逐字沿用**现有 Accent*（用户裁定：主色保持现有蓝紫，不引入微信绿），
        因此界面上看不出换色，但「主操作按钮」与「选中态 / 强调文字」从此语义分离，将来可各自演进。
    -->

    <!-- 背景与容器 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF11141C" />       <!-- 窗口底 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF181D28" />    <!-- 面板 -->
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF1F2634" /> <!-- 次级面板 / 悬停行 -->
    <SolidColorBrush x:Key="CardBrush" Color="#FF232B3A" />     <!-- 卡片 -->
    <SolidColorBrush x:Key="ChipBrush" Color="#FF232B3A" />     <!-- 状态胶囊 -->
    <SolidColorBrush x:Key="InputBrush" Color="#FF141924" />    <!-- 输入框底 -->
    <SolidColorBrush x:Key="ChatBgBrush" Color="#FF12161F" />   <!-- 聊天区底 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2F3A4E" />    <!-- 列表项悬停 -->
    <SolidColorBrush x:Key="BorderBrush2" Color="#FF2C3546" />  <!-- 边框 / 分隔线 -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EDF6" />     <!-- 主文字 -->
    <SolidColorBrush x:Key="TextSoftBrush" Color="#FFC3CCDC" /> <!-- 次要正文 -->
    <SolidColorBrush x:Key="TextMidBrush" Color="#FF9DA9BE" />  <!-- 说明文字 -->
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8D9AB2" />    <!-- 弱化文字 -->
    <SolidColorBrush x:Key="FaintBrush" Color="#FF6F7C93" />    <!-- 最弱（脚注 / 版本号） -->

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6E9CF5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4A78D6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF9FC0FF" /> <!-- 强调色系的文字 -->

    <!-- 状态色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD9534F" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FF7A2B2B" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFA03A3A" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FF9B3838" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFE06060" />
    <SolidColorBrush x:Key="OkBrush" Color="#FF8FE3B4" />
    <SolidColorBrush x:Key="ChatBrush" Color="#FF7BE0C0" />
    <SolidColorBrush x:Key="PrivateBrush" Color="#FFFFCE6B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="PhaseBrush" Color="#FFB79CFF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFFFCE6B" />

    <!-- ═══════════════ v2.5.0 小程序骨架：语义键 ═══════════════ -->
    <!-- 页面与容器 -->
    <SolidColorBrush x:Key="PageBgBrush" Color="#FF0E1117" />     <!-- 页面级背景（卡片外的底） -->
    <SolidColorBrush x:Key="NavBarBgBrush" Color="#FF181D28" />   <!-- 导航栏底（与卡片区分） -->
    <SolidColorBrush x:Key="NavBarTextBrush" Color="#FFE8EDF6" /> <!-- 导航标题文字 -->
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2C3546" />    <!-- 列表分隔线（1px） -->
    <SolidColorBrush x:Key="CardAltBrush" Color="#FF1A2029" />    <!-- 卡片内次级区块 / 分组头 -->

    <!-- 主操作（取值沿用 Accent*：保留现有蓝主色，不引入微信绿） -->
    <SolidColorBrush x:Key="ActionBrush" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="ActionTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#FF6E9CF5" />
    <SolidColorBrush x:Key="ActionPressedBrush" Color="#FF4A78D6" />
    <SolidColorBrush x:Key="ActionDisabledBrush" Color="#FF3A4252" />

    <!-- 称号（金）：唯一新增的色相 -->
    <SolidColorBrush x:Key="TitleTextBrush" Color="#FFFFD98A" />
    <SolidColorBrush x:Key="TitleBorderBrush" Color="#FFE0B96B" />
    <SolidColorBrush x:Key="TitleBgBrush" Color="#33FFD98A" />

    <!-- 浮层与表单 -->
    <SolidColorBrush x:Key="MaskBrush" Color="#99000000" />        <!-- 页面内浮层遮罩 -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#FF6F7C93" /> <!-- 输入框占位文字 -->

    <!-- 通用胶囊 -->
    <SolidColorBrush x:Key="ChipTextBrush" Color="#FFC3CCDC" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#FF3A4459" />

    <!--
        房主设置窗口「游戏徽章」描边的兜底色：房间没带主题色时用主题提供的中性色，
        避免在 XAML 里写死 #7C8AA5（待办 T4）。
    -->
    <Color x:Key="GameBadgeFallbackColor">#FF7C8AA5</Color>
</ResourceDictionary>
