<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ═══════════════ 亮色主题配色 ═══════════════

        键名必须与 Colors.Dark.xaml 完全一致（ThemeManager 会把深色字典整体换成这一份）。
        调整原则：文字对比度 ≥ 4.5:1，浅底上用深文字，强调色稍微加深以免发飘。
    -->

    <!-- 背景与容器 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFF1F4F9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFEFF3F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFE7EDF6" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FFE1E8F3" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChatBgBrush" Color="#FFF8FAFD" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE6ECF6" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FFD2DAE6" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF161C28" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#FF3A4457" />
    <SolidColorBrush x:Key="TextMidBrush" Color="#FF5C6879" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF6E7A8C" />
    <SolidColorBrush x:Key="FaintBrush" Color="#FF8C95A5" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6BE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4A82EA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2455B8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF1F5BD0" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC73833" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FFFBE7E7" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFE9B4B4" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFA82F2F" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC03535" />
    <SolidColorBrush x:Key="OkBrush" Color="#FF1E8E5A" />
    <SolidColorBrush x:Key="ChatBrush" Color="#FF0F7A5C" />
    <SolidColorBrush x:Key="PrivateBrush" Color="#FF9A6A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC62828" />
    <SolidColorBrush x:Key="PhaseBrush" Color="#FF6B4FD8" />
</ResourceDictionary>
