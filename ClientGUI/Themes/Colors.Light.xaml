<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ═══════════════ 亮色主题配色 ═══════════════

        键名必须与 Colors.Dark.xaml 完全一致（ThemeManager 会把深色字典整体换成这一份）。
        调整原则：文字对比度 ≥ 4.5:1，浅底上用深文字，强调色稍微加深以免发飘。

        v2.5.0 新增 17 个语义键 + 1 个兜底 Color，键名与 Colors.Dark.xaml 逐字一致
        （详见 docs/v25/ARCHITECTURE.md §4.1）；Action* 沿用现有 Accent* 取值。
    -->

    <!-- 背景与容器 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFF1F4F9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFEFF3F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFE7EDF6" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FFE1E8F3" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChatBgBrush" Color="#FFF8FAFD" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE6ECF6" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FFD2DAE6" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF161C28" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#FF3A4457" />
    <SolidColorBrush x:Key="TextMidBrush" Color="#FF5C6879" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF6E7A8C" />
    <SolidColorBrush x:Key="FaintBrush" Color="#FF8C95A5" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6BE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4A82EA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2455B8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF1F5BD0" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC73833" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FFFBE7E7" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFE9B4B4" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FFA82F2F" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC03535" />
    <SolidColorBrush x:Key="OkBrush" Color="#FF1E8E5A" />
    <SolidColorBrush x:Key="ChatBrush" Color="#FF0F7A5C" />
    <SolidColorBrush x:Key="PrivateBrush" Color="#FF9A6A00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC62828" />
    <SolidColorBrush x:Key="PhaseBrush" Color="#FF6B4FD8" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FF9A6A00" />

    <!-- ═══════════════ v2.5.0 小程序骨架：语义键 ═══════════════ -->
    <!-- 页面与容器（浅色 = 微信灰底 + 纯白导航栏 / 卡片） -->
    <SolidColorBrush x:Key="PageBgBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NavBarBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NavBarTextBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#FFF7F8FA" />

    <!-- 主操作（取值沿用 Accent*：保留现有蓝主色，不引入微信绿） -->
    <SolidColorBrush x:Key="ActionBrush" Color="#FF2F6BE0" />
    <SolidColorBrush x:Key="ActionTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#FF4A82EA" />
    <SolidColorBrush x:Key="ActionPressedBrush" Color="#FF2455B8" />
    <SolidColorBrush x:Key="ActionDisabledBrush" Color="#FFC8CDD4" />

    <!--
        称号（金）：浅色主题用深金，压在 CardBrush(#E7EDF6) 上对比度必须 ≥ 4.5:1（WCAG AA 正文档）。

        v2.6.0 S5（Q-B3-01 回修）：原来写的是 #B07D12，实测只有 **3.08:1** —— 而这行注释当时
        已经声称"≥ 4.5:1"，属于**注释撒谎**（没人算过）。现在改成 #8A5F00，实测 **4.80:1**；
        并由 ClientGUI.Tests 的 AppShellGuard.CheckTitleContrast 用 WCAG 相对亮度公式**算**一遍
        （两套主题都算，阈值 4.5），以后谁再调这个值而没算对比度，断言会立刻红。
    -->
    <SolidColorBrush x:Key="TitleTextBrush" Color="#FF8A5F00" />
    <SolidColorBrush x:Key="TitleBorderBrush" Color="#FFD9A83A" />
    <SolidColorBrush x:Key="TitleBgBrush" Color="#1AC9971F" />

    <!-- 浮层与表单 -->
    <SolidColorBrush x:Key="MaskBrush" Color="#66000000" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#FFA8AFBA" />

    <!-- 通用胶囊 -->
    <SolidColorBrush x:Key="ChipTextBrush" Color="#FF5A6472" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#FFDDE1E7" />

    <!-- 房主设置「游戏徽章」描边兜底色（待办 T4，键名与深色一致）。 -->
    <Color x:Key="GameBadgeFallbackColor">#FF6E7A8C</Color>
</ResourceDictionary>
