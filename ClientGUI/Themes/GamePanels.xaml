<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vmw="clr-namespace:ClientGUI.ViewModels.Games.Werewolf"
                    xmlns:vmu="clr-namespace:ClientGUI.ViewModels.Games"
                    xmlns:v="clr-namespace:ClientGUI.Views.Games">

    <!--
        游戏操作面板的模板注册表：按视图模型的**运行时类型**（DataType）选择面板。
        新增游戏 = 新增一个 `<Xxx>Panel.xaml` + 在此加一条 DataTemplate + 在
        GameViewModelFactory 加一条 case。这三处是「注册点」，不是平台模块。
    -->
    <DataTemplate DataType="{x:Type vmw:WerewolfViewModel}">
        <v:WerewolfPanel />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmu:UnknownGameViewModel}">
        <v:UnknownGamePanel />
    </DataTemplate>

</ResourceDictionary>
