<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClientGUI">

    <!--
        调色板 + 转换器。

        必须单独成一份字典，并被 DarkTheme.xaml 与 Panels.xaml 各自合并：
        XAML 解析期的 StaticResource 只在「本文档 + 其合并字典」里查找，
        看不到同级的其它合并字典。早期把画刷只放在 DarkTheme.xaml 里、
        又在 Panels.xaml 的日志模板中引用，解析失败会把 Foreground 设成
        DependencyProperty.UnsetValue，导致每次布局测量都抛异常。
    -->

    <!-- ═══════════════ 配色 ═══════════════ -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF11141C" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF181D28" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF1F2634" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF232B3A" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FF2C3546" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EDF6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8D9AB2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6E9CF5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD9534F" />
    <SolidColorBrush x:Key="ChatBrush" Color="#FF7BE0C0" />
    <SolidColorBrush x:Key="PrivateBrush" Color="#FFFFCE6B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="PhaseBrush" Color="#FFB79CFF" />

    <!-- ═══════════════ 转换器 ═══════════════ -->
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <local:EnabledToOpacityConverter x:Key="EnabledToOpacity" />

</ResourceDictionary>
