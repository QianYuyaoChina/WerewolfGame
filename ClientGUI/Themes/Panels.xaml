<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ClientGUI.ViewModels">

    <!--
        本字典在解析期需要 FlatButton / AccentBrush / 日志配色 / 转换器等，
        因此必须显式合并 Palette 与 DarkTheme，不能依赖 MainWindow 的兄弟字典。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- ═══════════════ 玩家列表行 ═══════════════ -->
    <DataTemplate x:Key="PlayerRowTemplate" DataType="{x:Type vm:PlayerRow}">
        <Border Background="{Binding RowBackground}"
                BorderBrush="{Binding RowBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,8"
                Cursor="{Binding Cursor}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 编号 -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                        Background="#FF2B3446" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Slot}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#FFCFDAEC"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 名字 / 身份 / 标记 -->
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                   Foreground="#FFE8EDF6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYou}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#FF9FC0FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDead}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="#FF74809A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding Tags}" FontSize="10.5" Foreground="#FF8D9AB2"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- 身份 + 选中标记 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RoleText}" FontSize="11.5" HorizontalAlignment="Right"
                               Foreground="{Binding RoleBrush}"
                               Visibility="{Binding HasRole, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="✔ 已选" FontSize="10.5" Foreground="#FF7CC4FF" HorizontalAlignment="Right"
                               Margin="0,2,0,0"
                               Visibility="{Binding IsTarget, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══════════════ 操作按钮 ═══════════════ -->
    <DataTemplate x:Key="ActionButtonTemplate" DataType="{x:Type vm:GameAction}">
        <Button Command="{Binding Command}"
                CommandParameter="{Binding Parameter}"
                IsEnabled="{Binding IsEnabled}"
                Margin="0,0,0,8"
                HorizontalContentAlignment="Stretch">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                    <Setter Property="Padding" Value="12,10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                            <Setter Property="Background" Value="#FF7A2B2B" />
                            <Setter Property="BorderBrush" Value="#FFA83C3C" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPrimary}" Value="True" />
                                <Condition Binding="{Binding IsEnabled}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDanger}" Value="True" />
                                <Condition Binding="{Binding IsEnabled}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <!--
                注意：按钮内的文字颜色绝不能绑定到 Button.Foreground（RelativeSource AncestorType=Button），
                那会形成模板自引用，在布局/文本测量阶段递归到栈溢出。这里改用固定的文字色 +
                针对禁用态的数据触发器来表达“变灰”。
            -->
            <StackPanel Opacity="{Binding IsEnabled, Converter={StaticResource EnabledToOpacity}}">
                <TextBlock Text="{Binding Label}" FontSize="13.5" HorizontalAlignment="Left"
                           Foreground="#FFF0F4FA" />
                <TextBlock Text="{Binding Hint}" FontSize="10.5" Margin="0,3,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Left"
                           Foreground="#FF9DA9BE"
                           Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- ═══════════════ 日志行 ═══════════════ -->
    <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
        <Grid Margin="0,1.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11" Margin="0,1,8,0"
                       Foreground="#FF5E6A80" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFDCE3EF" />
                        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="chat">
                                <Setter Property="Foreground" Value="{StaticResource ChatBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="private">
                                <Setter Property="Foreground" Value="{StaticResource PrivateBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="phase">
                                <Setter Property="Foreground" Value="{StaticResource PhaseBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
