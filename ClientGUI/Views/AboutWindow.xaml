<!--
    根元素的 Background/Foreground 必须用 DynamicResource：解析这两个属性时还看不到
    本元素下方声明的 Resources（与本仓库其它窗口一致）。
-->
<Window x:Class="ClientGUI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ClientGUI"
        mc:Ignorable="d"
        Title="关于"
        Height="560" Width="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题 -->
            <RowDefinition Height="Auto" />  <!-- 简介 -->
            <RowDefinition Height="Auto" />  <!-- 信息表 -->
            <RowDefinition Height="Auto" />  <!-- 技术栈 -->
            <RowDefinition Height="*" />     <!-- 说明 -->
            <RowDefinition Height="Auto" />  <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 ═══════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource CardBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="🐺" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:AppInfo.ProductName}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="v" FontSize="11.5" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static local:AppInfo.Version}" FontSize="11.5"
                                       Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Static local:AppInfo.Framework}" FontSize="11.5" Margin="10,3,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════ 简介 ═══════════════ -->
        <TextBlock Grid.Row="1" Text="{x:Static local:AppInfo.Description}" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,20,0,0" LineHeight="20"
                   Foreground="{DynamicResource TextSoftBrush}" />

        <!-- ═══════════════ 信息表 ═══════════════ -->
        <Border Grid.Row="2" Margin="0,18,0,0" Background="{DynamicResource CardBrush}"
                CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="解决方案" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static local:AppInfo.SolutionName}"
                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="客户端" Style="{StaticResource MutedText}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontSize="12.5"
                           Foreground="{DynamicResource TextBrush}"
                           Text="WPF 图形界面 · 控制台（共用核心库）" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="网络加密" Style="{StaticResource MutedText}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                           Text="PSK 认证 DH 握手 + AES-GCM 会话加密" />
            </Grid>
        </Border>

        <!-- ═══════════════ 技术栈 ═══════════════ -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="技术栈" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{x:Static local:AppInfo.TechStack}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                Padding="10,4" Margin="0,0,8,8">
                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextSoftBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ═══════════════ 说明 ═══════════════ -->
        <TextBlock Grid.Row="4" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" LineHeight="18"
                   VerticalAlignment="Top" Foreground="{DynamicResource FaintBrush}"
                   Text="本项目用于学习与演示。程序按“现状”提供，作者不对其适用性或运行结果作任何明示或暗示的担保。" />

        <!-- ═══════════════ 按钮 ═══════════════ -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="更新日志" Style="{StaticResource FlatButton}" Padding="16,8"
                    Click="OpenChangelog_OnClick" />
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="10,0,0,0"
                    Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
