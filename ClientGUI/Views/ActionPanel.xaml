<UserControl x:Class="ClientGUI.Views.ActionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClientGUI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        右栏：**游戏操作面板插槽**。
        宿主只提供一个容器（卡片 + 标题），真正的面板由 ContentControl 按 `Game` 的运行时类型
        从 Themes/GamePanels.xaml 里选模板装载（狼人杀 → WerewolfPanel；未知游戏 → UnknownGamePanel）。
        新增游戏只需新增面板 + 一条 DataTemplate，不必改动本文件。
    -->
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="可执行操作" Style="{StaticResource SectionTitle}" />

            <ContentControl Grid.Row="1"
                            Content="{Binding Game}"
                            VerticalContentAlignment="Top"
                            HorizontalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
