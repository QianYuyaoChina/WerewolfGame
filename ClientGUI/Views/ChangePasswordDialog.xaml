<!--
    修改密码浮层正文（v2.5.0 第 7 条）：旧密码 + 两遍新密码。

    它是一个 **UserControl**，由宿主浮层（OverlayDialog）塞进卡片正文里 ——
    不新增 Window 子类（结构契约 S1 不扩大），也不用 MessageBox（架构 K11）。

    密码框不支持数据绑定，因此 PasswordChanged 在代码里双向同步到视图模型。
-->
<UserControl x:Class="ClientGUI.Views.ChangePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="当前密码" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="OldPasswordBox" Style="{StaticResource FieldPassword}"
                     PasswordChanged="OldPasswordBox_OnPasswordChanged" />

        <TextBlock Text="新密码" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FieldPassword}"
                     PasswordChanged="NewPasswordBox_OnPasswordChanged" />

        <TextBlock Text="再输一遍新密码" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FieldPassword}"
                     PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />

        <!-- 两遍不一致：就地提示，且「确定」不可点（不发请求）。 -->
        <TextBlock x:Name="MismatchText" Style="{StaticResource FieldError}" Margin="0,8,0,0"
                   Text="{Binding MismatchHint, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding MismatchHint, Converter={StaticResource NonEmptyToVisibility}}" />

        <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="改完之后当前这次登录不用重来；下次登录请用新密码。" />
    </StackPanel>
</UserControl>
