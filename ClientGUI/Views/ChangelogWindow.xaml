<!--
    根元素的 Background/Foreground 必须用 DynamicResource（与本仓库其它窗口一致）。
-->
<Window x:Class="ClientGUI.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ClientGUI"
        xmlns:m="clr-namespace:ClientGUI.Models"
        mc:Ignorable="d"
        Title="更新日志"
        Height="620" Width="560"
        MinHeight="420" MinWidth="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 单条版本记录 -->
            <DataTemplate x:Key="ChangelogEntryTemplate" DataType="{x:Type m:ChangelogEntry}">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16,14"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- 版本徽章 + 日期 + 主题 -->
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="9,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="v" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="最新" FontSize="10.5" Margin="8,4,0,0" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsLatest, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Date}" FontSize="11.5" Margin="10,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />

                        <!-- 更新要点 -->
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="•" FontSize="13" Margin="2,0,8,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5"
                                                   TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource TextSoftBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题 -->
            <RowDefinition Height="*" />     <!-- 版本列表 -->
            <RowDefinition Height="Auto" />  <!-- 底部 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 ═══════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="📜" FontSize="22" VerticalAlignment="Center" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="更新日志" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="当前版本 v" />
                    <Run Text="{x:Static local:AppInfo.Version}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════ 版本列表 ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Static m:Changelog.All}"
                          ItemTemplate="{StaticResource ChangelogEntryTemplate}" />
        </ScrollViewer>

        <!-- ═══════════════ 底部 ═══════════════ -->
        <Button Grid.Row="2" Content="关闭" Style="{StaticResource PrimaryButton}" Padding="22,8"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="Close_OnClick" />
    </Grid>
</Window>
