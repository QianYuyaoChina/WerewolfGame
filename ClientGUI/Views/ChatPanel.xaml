<UserControl x:Class="ClientGUI.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClientGUI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 中栏：房间消息 + 发言输入 -->
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="房间消息" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="{Binding EndpointText}" FontSize="10.5" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource FaintBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource ChatBgBrush}" CornerRadius="8" Padding="4">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding Log}"
                         ItemTemplate="{StaticResource LogEntryTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         Focusable="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- 发言输入 -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" Grid.Column="0"
                         Style="{StaticResource FlatTextBox}"
                         Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanChat}"
                         MaxLength="200">
                    <TextBox.InputBindings>
                        <!-- 回车发送（省掉一个 KeyDown 事件处理方法）。 -->
                        <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="发送" Width="86" Margin="8,0,0,0"
                        Style="{StaticResource FlatButton}"
                        Command="{Binding SendChatCommand}"
                        IsEnabled="{Binding CanChat}" />
                <TextBlock Grid.Column="0" Text="{Binding ChatHint}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding CanChat, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
