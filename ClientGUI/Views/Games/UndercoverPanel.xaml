<UserControl x:Class="ClientGUI.Views.Games.UndercoverPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmu="clr-namespace:ClientGUI.ViewModels.Games.Undercover"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmu:UndercoverViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 谁是卧底面板正文：我的词 + 阶段头 + Actions + 玩法提示（装载在宿主 ActionPanel 的插槽里） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 我的词 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="你的词" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding YourWordDisplay}" FontSize="22" FontWeight="Bold"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />

                    <!--
                        身份区（v2.3.2 视角隔离）：
                        局中只显示「保密」徽标 —— 服务端根本不下发身份，面板也就无从泄露；
                        整局结束后才显示真实身份徽标。
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="7,2"
                                Visibility="{Binding IsRoleRevealed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding YourRoleDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="7,2"
                                Visibility="{Binding IsRoleHidden, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RoleHiddenDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding AliveText}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- 白板提示：没有词这件事本身属于规则，不算泄露阵营 -->
                    <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="7,2"
                            Margin="0,7,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding HasBlankHint, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BlankHintText}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>

                    <TextBlock Text="{Binding RoleHiddenNotice}" FontSize="11" Margin="0,7,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"
                               Visibility="{Binding HasRoleHiddenNotice, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding YourRoleDesc}" FontSize="11" Margin="0,7,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding CategoryText}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource FaintBrush}"
                               Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding MeText}" FontSize="10.5" Margin="0,6,0,0"
                               Foreground="{DynamicResource FaintBrush}" />
                    <TextBlock Text="{Binding RoleSummary}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}"
                               Visibility="{Binding HasRoleSummary, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 阶段头 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PhaseDisplay}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding RoundText}" FontSize="11.5" Margin="10,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActionHint}" FontSize="11.5" Margin="0,7,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMidBrush}"
                               Visibility="{Binding HasActionHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 轮流发言：当前发言人 + 进度；轮到自己时整个卡片高亮 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                    BorderThickness="1.4"
                    Visibility="{Binding HasSpeakerText, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMyTurnToSpeak}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding SpeakerText}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding SpeakProgressText}" FontSize="11" Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="轮到你时，下方「房间消息」输入框才可用：描述你的词后发送，即自动轮到下一位。"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}"
                               Visibility="{Binding IsMyTurnToSpeak, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ActionsList}"
                          ItemTemplate="{StaticResource ActionButtonTemplate}" />

            <!--
                空状态：绑定到视图模型属性，不要在面板内对 Count 做 DataTrigger
                （测量期间反复失效会导致无限测量递归）。
            -->
            <TextBlock Text="当前阶段暂无可用操作，请等待服务器提示。"
                       TextWrapping="Wrap" Margin="2,4,2,0"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Visibility="{Binding IsActionsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,10,0,12" />

            <TextBlock Text="玩法提示" Style="{StaticResource SectionTitle}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="· 大多数人拿到同一个词，卧底拿到相近的另一个词；人多时还会掺入**白板**（没有词，只能听别人的描述推测）。&#x0a;· **你不会被告知自己是卧底还是平民**，请靠大家的描述自己判断；只有整局结束才会揭晓身份。&#x0a;· 白板知道自己没有词（这是规则本身），要装作有词的样子活到最后。&#x0a;· 描述阶段：**按顺序轮流发言**——轮到谁，谁才能在「房间消息」里发言（没轮到时发送按钮不可用）；不想说可以点【跳过本轮发言】。&#x0a;· 投票阶段：点击左侧玩家选出你认为的卧底，再点【确认投票】；平票则本轮无人出局。&#x0a;· 出局者的身份会当场公开；卧底阵营（卧底 + 白板）全部出局 → 平民阵营胜，卧底阵营不少于平民 → 卧底阵营胜。&#x0a;· 词库在服务器目录的 words.undercover.txt，按「平民词|卧底词|分类」每行一对添加。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
