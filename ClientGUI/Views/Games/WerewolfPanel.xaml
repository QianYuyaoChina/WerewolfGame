<UserControl x:Class="ClientGUI.Views.Games.WerewolfPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmw="clr-namespace:ClientGUI.ViewModels.Games.Werewolf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmw:WerewolfViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 狼人杀面板正文：我的身份 + 阶段头 + Actions + 玩法提示（装载在宿主 ActionPanel 的插槽里） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 我的身份 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="我的身份" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding YourRoleDisplay}" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="7,2" Margin="10,3,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding AliveText}" FontSize="11"
                                       Foreground="{Binding AliveBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding YourRoleDesc}" FontSize="11" Margin="0,7,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding MeText}" FontSize="10.5" Margin="0,6,0,0"
                               Foreground="{DynamicResource FaintBrush}" />

                    <!-- 情侣 / 警长（有才显示） -->
                    <TextBlock Text="{Binding LoverText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <TextBlock Text="{Binding SheriffText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSoftBrush}" />

                    <!-- 本局身份配置（开局时服务端已向全房间公布） -->
                    <TextBlock Text="{Binding RoleSummary}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}"
                               Visibility="{Binding HasRoleSummary, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 阶段头 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10"
                    Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PhaseDisplay}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding PhaseBrush}" />
                        <TextBlock Text="{Binding DayText}" FontSize="11.5" Margin="10,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActionHint}" FontSize="11.5" Margin="0,7,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMidBrush}"
                               Visibility="{Binding HasActionHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Actions}"
                          ItemTemplate="{StaticResource ActionButtonTemplate}" />

            <!--
                空状态提示：普通 OneWay 绑定到视图模型属性（不要在面板内对 Actions.Count 做 DataTrigger，
                那会在测量期间反复失效，导致无限测量递归）。
            -->
            <TextBlock Text="当前阶段暂无可用操作，请等待服务器提示。"
                       TextWrapping="Wrap" Margin="2,4,2,0"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       Visibility="{Binding IsActionsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,10,0,12" />

            <TextBlock Text="玩法提示" Style="{StaticResource SectionTitle}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Text="· 夜晚：丘比特首夜牵线，狼人选择击杀目标，预言家查验，女巫用药，守卫守护。&#x0a;· 白天：讨论后投票放逐一名玩家；警长投票计 1.5 票，并可移交警徽。&#x0a;· 猎人出局时可开枪带走一名玩家；情侣一方出局另一方殉情。&#x0a;· 身份配置由房主在「房主设置」里自定义，开局时会公布给全房间。&#x0a;· 指令与服务器约定一致：数字编号选择目标，-1 表示弃票 / 放弃。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
