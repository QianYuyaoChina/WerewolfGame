<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。
-->
<Window x:Class="ClientGUI.Views.HostSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        Title="房主设置"
        Height="612" Width="584"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 ═══════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource CardBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="👑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="房主设置" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="RoomText" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════ 标签页 ═══════════════ -->
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource FlatTabControl}">

            <!-- ─────────── 房间 ─────────── -->
            <TabItem Header="房间">
                <StackPanel>
                    <TextBlock Text="最大人数" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="MaxPlayersInput" Style="{StaticResource FlatTextBox}" Width="120"
                             HorizontalAlignment="Left" />
                    <TextBlock x:Name="MaxPlayersHint" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />

                    <TextBlock Text="房间密码" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource FlatPasswordBox}" />
                    <CheckBox x:Name="ClearPasswordBox" Content="清除密码（改为公开房间）" Margin="0,10,0,0"
                              Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="留空表示不修改密码。改密码不会影响已经发出去的邀请码。"
                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />
                </StackPanel>
            </TabItem>

            <!-- ─────────── 身份配置 ─────────── -->
            <TabItem Header="身份配置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="LayoutHint" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LayoutList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoleCountRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                                 Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="恢复默认布局" Style="{StaticResource FlatButton}" Padding="14,6"
                                Click="ResetLayout_OnClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─────────── 邀请码 ─────────── -->
            <TabItem Header="邀请码">
                <StackPanel>
                    <TextBlock Text="当前邀请码" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="InviteCodeBox" Style="{StaticResource FlatTextBox}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="96"
                             Padding="10,8" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" />
                    <TextBlock Text="邀请码里放的是房间的邀请令牌（不是密码），所以修改房间密码后它依然有效；只有点「重置邀请令牌」才会让旧码失效。"
                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="复制邀请码" Style="{StaticResource FlatButton}" Padding="14,7"
                                Click="CopyInvite_OnClick" />
                        <Button Content="重置邀请令牌（作废旧码）" Style="{StaticResource DangerButton}"
                                Padding="14,7" Margin="10,0,0,0" Click="ResetInvite_OnClick" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ 状态 ═══════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="6"
                Padding="12,9" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="正在读取房间设置…" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />
        </Border>

        <!-- ═══════════════ 按钮 ═══════════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource FlatButton}" Padding="18,8" Margin="0,0,10,0"
                    Click="Close_OnClick" />
            <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Padding="18,8"
                    Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</Window>
