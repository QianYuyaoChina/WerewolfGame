<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。

    v2.5.0 小程序骨架：导航栏 56（居中标题）+ 灰底上的白色卡片内容区 + 通栏底部主按钮。
    本窗口依然是 Window 子类（结构契约 S1：冒烟会按 new InviteCodeWindow(string) 实例化），
    只是外观改成小程序页面；新增的对话框一律改用页面内浮层 OverlayDialog。
-->
<Window x:Class="ClientGUI.Views.InviteCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="房间邀请码"
        Height="440" Width="508"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏 ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <TextBlock x:Name="NavTitleText" Text="房间邀请码" Style="{StaticResource NavTitleText}" />
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="好友粘贴后可直接进入本房间，无需再输房间密码。"
                                   Style="{StaticResource MinorText}" Margin="0,0,0,12" />

                        <TextBlock Text="邀请码（只读，可选中复制）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource FlatTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="96" Padding="10,8"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />

                        <TextBlock Text="邀请码已加密，内含服务器地址、房间号与房间密码；请只发给可信的人。"
                                   Style="{StaticResource FieldHint}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MinorText}" />
                        <TextBlock Style="{StaticResource FootnoteText}" Margin="0,12,0,0"
                                   Text="对方怎么用：打开客户端 → 登录窗口的「邀请码」框（或房间列表的邀请码框）粘贴本码 → 点「使用 / 加入」即可直接进房。&#x0a;复制不了时：在上方框内点击 → Ctrl+A 全选 → Ctrl+C 复制。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <StackPanel>
                <Button x:Name="PrimaryAction" Content="复制邀请码" Style="{StaticResource BlockPrimaryButton}"
                        Click="Copy_OnClick" />
                <Button Content="关闭" Style="{StaticResource BlockSecondaryButton}" Margin="0,8,0,0"
                        Click="Close_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
