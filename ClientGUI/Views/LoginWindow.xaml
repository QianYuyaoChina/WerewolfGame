<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources（主窗口同理）。
-->
<Window x:Class="ClientGUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="狼人杀 · 登录"
        Height="546" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="LoginWindow_OnKeyDown">

    <!-- 与主窗口一样用 pack URI 定位主题，保证从任意工作目录启动都能解析。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题 -->
            <RowDefinition Height="Auto" />  <!-- 服务器地址 -->
            <RowDefinition Height="Auto" />  <!-- 用户名 -->
            <RowDefinition Height="Auto" />  <!-- 密码 -->
            <RowDefinition Height="Auto" />  <!-- 登录按钮 -->
            <RowDefinition Height="Auto" />  <!-- 状态 -->
            <RowDefinition Height="*" />     <!-- 底部提示 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 ═══════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🐺" FontSize="26" VerticalAlignment="Center" />
                <TextBlock Text="狼人杀" FontSize="22" FontWeight="Bold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <TextBlock Text="登录后进入房间" FontSize="12" Margin="0,8,0,0"
                       HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- ═══════════════ 服务器地址 ═══════════════ -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="服务器地址" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <TextBox x:Name="ServerUrlInput"
                     Style="{StaticResource FlatTextBox}"
                     Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIdle}" />
        </StackPanel>

        <!-- ═══════════════ 用户名 ═══════════════ -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="用户名" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <TextBox x:Name="UsernameInput"
                     Style="{StaticResource FlatTextBox}"
                     Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsIdle}"
                     MaxLength="20" />
        </StackPanel>

        <!-- ═══════════════ 密码 ═══════════════ -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="密码" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource FlatPasswordBox}"
                         IsEnabled="{Binding IsIdle}"
                         PasswordChanged="PasswordInput_OnPasswordChanged" />
        </StackPanel>

        <!-- ═══════════════ 登录按钮 ═══════════════ -->
        <Button Grid.Row="4" Margin="0,22,0,0" Height="42"
                Style="{StaticResource PrimaryButton}"
                Content="登录 / 注册"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsIdle}" />

        <!-- ═══════════════ 状态 ═══════════════ -->
        <Border Grid.Row="5" Margin="0,14,0,0" Padding="12,9" CornerRadius="6"
                Background="{StaticResource CardBrush}">
            <!--
                文字颜色交给样式 + DataTrigger；不要在元素上直接写 Foreground，
                本地值优先级高于样式触发器，会让“失败标红”失效。
            -->
            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ═══════════════ 底部提示 ═══════════════ -->
        <TextBlock Grid.Row="6" Margin="0,16,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="#FF6F7C93" VerticalAlignment="Bottom"
                   Text="首次登录的用户名会自动注册；掉线后用相同的用户名 + 密码重新登录即可恢复房间身份。&#x0a;默认地址 http://localhost:5000/gamehub" />
    </Grid>
</Window>
