<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources（主窗口同理）。

    本窗口在 v2.4.0 重写为两个标签页：
      Tab1「创建内置服务器」—— 在这台电脑上直接开一个服务器（本次新增的卖点，默认停留）
      Tab2「连接现有服务器」—— 控件、默认值、邀请码逻辑与改造前逐项一致
    两个标签页共享用户名 / 密码与底部状态条（切页不丢输入）。
-->
<Window x:Class="ClientGUI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        Title="狼人杀 · 登录"
        Height="792" Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="LoginWindow_OnKeyDown">

    <!-- 与主窗口一样用 pack URI 定位主题，保证从任意工作目录启动都能解析。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题 -->
            <RowDefinition Height="*" />
            <!-- 标签页 -->
            <RowDefinition Height="Auto" />
            <!-- 状态条 -->
            <RowDefinition Height="Auto" />
            <!-- 底部提示 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 + 右上角设置 ═══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🐺" FontSize="26" VerticalAlignment="Center" />
                <TextBlock Text="狼人杀" FontSize="22" FontWeight="Bold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
            <TextBlock Text="开服务器或直接加入" FontSize="12" Margin="132,33,0,-26"
                       HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" />

            <!-- 设置入口统一放右上角（与主窗口、房间列表一致） -->
            <Button Content="⚙ 设置" Style="{StaticResource FlatButton}" Padding="12,6"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Settings_OnClick" ToolTip="外观主题等设置（快捷键 Ctrl + ,）" />
        </Grid>

        <!-- ═══════════════ 两个标签页 ═══════════════ -->
        <TabControl x:Name="Tabs" Grid.Row="1"
                    Style="{StaticResource FlatTabControl}"
                    SelectionChanged="Tabs_OnSelectionChanged">

            <!-- ─────────── Tab 1：创建内置服务器 ─────────── -->
            <TabItem x:Name="EmbeddedTab" Header="🖥 创建内置服务器"
                     DataContext="{Binding Embedded, RelativeSource={RelativeSource AncestorType=Window}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel Margin="0,2,0,0">

                        <!-- 端口 -->
                        <TextBlock Text="端口" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PortInput" Grid.Column="0"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditPort}"
                                     MaxLength="5" />
                            <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                      Content="被占用时自动换一个空闲端口"
                                      IsChecked="{Binding AllowPortDrift}"
                                      IsEnabled="{Binding CanEditPort}"
                                      Foreground="{DynamicResource TextSoftBrush}"
                                      FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding PortError}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Visibility="{Binding IsPortValid, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- 三个按钮 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Padding="18,9" Height="40"
                                    Content="{Binding StartButtonText}"
                                    Command="{Binding StartAndEnterCommand}"
                                    ToolTip="启动内置服务器 → 自动连接 → 用下面的账号登录" />
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                                    Padding="14,9" Height="40" Margin="8,0,0,0"
                                    Content="仅启动服务器"
                                    Command="{Binding StartOnlyCommand}"
                                    ToolTip="只开服务器并给出可分享地址，自己先不进" />
                            <Button Grid.Column="3" Style="{StaticResource DangerButton}"
                                    Padding="14,9" Height="40"
                                    Content="停止"
                                    Command="{Binding StopCommand}" />
                        </Grid>

                        <!-- 运行信息 -->
                        <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="7"
                                Background="{DynamicResource CardBrush}">
                            <StackPanel>
                                <!-- 状态徽章 -->
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Stopping">
                                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StateText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RuntimeText}" FontSize="11.5" Margin="12,0,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- 本机地址 -->
                                <TextBlock Text="本机地址" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                             Text="{Binding LocalUrlText, Mode=OneWay}"
                                             IsReadOnly="True" FontSize="12" />
                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource FlatButton}"
                                            Padding="12,8" Margin="8,0,0,0"
                                            Command="{Binding CopyCommand}"
                                            CommandParameter="{Binding LocalUrlText}" />
                                </Grid>

                                <!-- 局域网地址 -->
                                <TextBlock Text="局域网地址（发给朋友）" Style="{StaticResource MutedText}"
                                           Margin="0,10,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                             Text="{Binding LanUrlText, Mode=OneWay}"
                                             IsReadOnly="True" FontSize="12" />
                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource FlatButton}"
                                            Padding="12,8" Margin="8,0,0,0"
                                            Command="{Binding CopyCommand}"
                                            CommandParameter="{Binding LanUrlText}" />
                                </Grid>

                                <!-- 端口漂移提示 / 工作目录 -->
                                <TextBlock Text="{Binding DriftNote}" FontSize="11" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                           Visibility="{Binding HasDriftNote, Converter={StaticResource BoolToVisibility}}" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding WorkDirectoryText}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center" ToolTip="{Binding WorkDirectoryText}" />
                                    <Button Grid.Column="1" Content="打开服务器目录" Style="{StaticResource FlatButton}"
                                            Padding="10,6" Margin="8,0,0,0" FontSize="11.5"
                                            Command="{Binding OpenDirectoryCommand}"
                                            ToolTip="打开配置 / 账号 / 词库所在的目录" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 用户名 / 密码（与 Tab2 共用同一份凭据，切页不丢） -->
                        <TextBlock Text="用户名" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                        <TextBox x:Name="EmbeddedUsernameInput"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding Login.UsernameInput, UpdateSourceTrigger=PropertyChanged,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                 IsEnabled="{Binding Login.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                 MaxLength="20" />

                        <TextBlock Text="密码" Style="{StaticResource MutedText}" Margin="0,12,0,6" />
                        <PasswordBox x:Name="EmbeddedPasswordInput"
                                     Style="{StaticResource FlatPasswordBox}"
                                     IsEnabled="{Binding Login.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                     PasswordChanged="EmbeddedPasswordInput_OnPasswordChanged" />

                        <Button Margin="0,14,0,0" Height="40" Padding="14,9"
                                Style="{StaticResource FlatButton}"
                                Content="登录 / 注册（连这台电脑上的服务器）"
                                Command="{Binding LoginToEmbeddedCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─────────── Tab 2：连接现有服务器（与改造前逐项一致） ─────────── -->
            <TabItem x:Name="ExternalTab" Header="🌐 连接现有服务器"
                     DataContext="{Binding Login, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Margin="0,2,0,0">
                    <TextBlock Text="服务器地址" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <TextBox x:Name="ServerUrlInput"
                             Style="{StaticResource FlatTextBox}"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}" />

                    <!--
                        邀请码：粘贴好友分享的码后点「使用」，会自动填好上面的服务器地址，
                        登录成功后直接进入该房间（房间密码由邀请码携带，无需手动输入）。
                    -->
                    <TextBlock Text="邀请码（可选）" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InviteCodeInput" Grid.Column="0"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="1" Content="使用邀请码" Style="{StaticResource FlatButton}"
                                Padding="14,8" Margin="8,0,0,0"
                                Command="{Binding UseInviteCommand}"
                                IsEnabled="{Binding IsIdle}" />
                    </Grid>
                    <TextBlock Text="{Binding InviteHint}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource OkBrush}"
                               Visibility="{Binding HasInviteHint, Converter={StaticResource BoolToVisibility}}" />

                    <!-- ═══════════════ 用户名 ═══════════════ -->
                    <TextBlock Text="用户名" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                    <TextBox x:Name="UsernameInput"
                             Style="{StaticResource FlatTextBox}"
                             Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsIdle}"
                             MaxLength="20" />

                    <!-- ═══════════════ 密码 ═══════════════ -->
                    <TextBlock Text="密码" Style="{StaticResource MutedText}" Margin="0,12,0,6" />
                    <PasswordBox x:Name="PasswordInput"
                                 Style="{StaticResource FlatPasswordBox}"
                                 IsEnabled="{Binding IsIdle}"
                                 PasswordChanged="PasswordInput_OnPasswordChanged" />

                    <!-- ═══════════════ 登录按钮 ═══════════════ -->
                    <Button Margin="0,20,0,0" Height="42"
                            Style="{StaticResource PrimaryButton}"
                            Content="登录 / 注册"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsIdle}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ 共享状态条 ═══════════════ -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,9" CornerRadius="6"
                Background="{DynamicResource CardBrush}">
            <!--
                文字颜色交给样式 + DataTrigger；不要在元素上直接写 Foreground，
                本地值优先级高于样式触发器，会让“失败标红”失效。
            -->
            <TextBlock Text="{Binding Login.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Login.ShowError, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ═══════════════ 底部提示 ═══════════════ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource FaintBrush}"
                       Text="内置服务器只在这台电脑上跑，关掉客户端会一起关掉；想让同网络的朋友加入，把上面的局域网地址发给他即可（首次监听若弹出防火墙提示，请选择允许）。&#x0a;首次登录的用户名会自动注册；掉线后用相同的用户名 + 密码重新登录即可恢复原房间身份。&#x0a;默认地址 http://localhost:5000/gamehub（快速幂协商密钥 + 会话加密）" />
        </Grid>
    </Grid>
</Window>
