<!--
    ⚠ 页面与窗口的三点差别见 CreateRoomPage.xaml 顶部注释（DynamicResource / UserControl 祖先 / 无 DialogResult）。

    本页由 Views/ChangelogWindow.xaml 原样搬迁（v2.6.0 S3 页面化，架构 §9.1）。
    必须保留的形体：
      · 📜 图标 + 标题 + 「当前版本 vX.Y.Z」；
      · 版本列表**倒序**（最新在最上，由 Models/Changelog.All 的顺序决定），长文本可滚动；
      · 每条记录的版本徽章（最新那条用强调色、其余用底纹色）、「最新」标签、日期、标题、要点列表；
      · 徽章文字色跟随主题（浅色主题下不能白字白底 —— 那是 B3 修过的回归点）。
    尺寸沿用旧窗口 560×620。

    入栈方式：**Push（换页）**，返回即回到打开它的那一页（房间页或关于页）。
-->
<UserControl x:Class="ClientGUI.Views.Pages.ChangelogPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ClientGUI"
        xmlns:m="clr-namespace:ClientGUI.Models"
        mc:Ignorable="d"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                版本徽章文字色跟随主题：非最新条目贴在 PanelAltBrush 上（浅色主题是浅底），
                硬编码 White 会导致浅色模式下「白字白底」看不见。
            -->
            <Style x:Key="VersionBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLatest}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 单条版本记录 -->
            <DataTemplate x:Key="ChangelogEntryTemplate" DataType="{x:Type m:ChangelogEntry}">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16,14"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- 版本徽章 + 日期 + 主题 -->
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="9,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="v" Style="{StaticResource VersionBadgeText}" />
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource VersionBadgeText}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="最新" FontSize="10.5" Margin="8,4,0,0" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsLatest, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Date}" FontSize="11.5" Margin="10,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />

                        <!-- 更新要点 -->
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="•" FontSize="13" Margin="2,0,8,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5"
                                                   TextWrapping="Wrap" LineHeight="19"
                                                   Foreground="{DynamicResource TextSoftBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 版本列表 -->
            <RowDefinition Height="Auto" />  <!-- 底部 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="返回" Style="{StaticResource NavIconButton}"
                            Click="Back_OnClick" ToolTip="回到打开本页的那一页" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="更新日志"
                           Style="{StaticResource NavTitleText}" />

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══════════════ 版本列表（倒序） ═══════════════ -->
        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="📜" FontSize="22" VerticalAlignment="Center" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="更新日志" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="当前版本 v" />
                        <Run Text="{x:Static local:AppInfo.Version}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChangelogList" ItemsSource="{x:Static m:Changelog.All}"
                              ItemTemplate="{StaticResource ChangelogEntryTemplate}" />
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ 底部（右对齐，与旧窗口一致） ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <Button x:Name="CloseAction" Content="关闭" Style="{StaticResource PrimaryButton}" Padding="22,8"
                    HorizontalAlignment="Right" Click="Close_OnClick" />
        </Border>
    </Grid>
</UserControl>
