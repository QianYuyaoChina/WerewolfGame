<!--
    ⚠ 页面（UserControl）与窗口（Window）的三点差别（改这里时务必注意）：
      1. 根元素上的 Background/Foreground 仍必须用 DynamicResource（颜色由 ThemeManager 挂在
         Application 级，静态资源在解析时看不到元素下面声明的 Resources）；
      2. 页内任何 RelativeSource 的 AncestorType 必须是 UserControl —— 原来写 Window 的绑定
         换到页面里会找不到祖先，界面会静默丢数据；
      3. 页面没有 ShowDialog()/DialogResult：结果通过 NavigationService.Complete(...) 回传，
         由「带结果返回」的 PushForResultAsync 接住（架构 D3 / T41）。

    本页由 Views/CreateRoomWindow.xaml 原样搬迁（v2.6.0 S2 页面化，架构 §9.1）。

    结构契约（守住旧窗口那套断言的可比性）必须保留：
      · GameBox 必须有 ItemTemplate（只写 DisplayMemberPath 会退化成显示类型名）；
      · RoomNameInput / PasswordInput / PrimaryAction / NavBar / NavTitleText 命名不变。

    导航栏结构与其它页面一致：*|Auto|* 三列 —— 两侧等分让标题**几何居中**（I5），
    左槽位放「返回」（浮层也要能用鼠标退出，不能只靠 Esc）。
-->
<UserControl x:Class="ClientGUI.Views.Pages.CreateRoomPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        xmlns:share="clr-namespace:Werewolf.Client.Share;assembly=Werewolf.Client.Share"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CreateRoomViewModel}"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="返回" Style="{StaticResource NavIconButton}"
                            Click="Back_OnClick" ToolTip="取消创建并返回房间列表" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="创建房间"
                           Style="{StaticResource NavTitleText}" />

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="游戏" Style="{StaticResource FieldLabel}" />
                    <!--
                        显式给出 ItemTemplate：只写 DisplayMemberPath 时可能退化成显示对象本身
                        （也就是用户看到的「未本地化的类型名」）。这里直接用「图标 + 名称 + 简介」。
                    -->
                    <ComboBox x:Name="GameBox" Style="{StaticResource FlatComboBox}"
                              ItemsSource="{Binding Games}"
                              SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type share:GameInfo}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Emoji}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" Margin="6,0,0,0"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Tagline}" FontSize="11" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="房间名" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <TextBox x:Name="RoomNameInput" Style="{StaticResource FieldInput}"
                             Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="40" />

                    <TextBlock Text="密码（可选）" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPassword}"
                                 PasswordChanged="PasswordInput_OnPasswordChanged" />

                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,16,0,0"
                               Text="房间名可留空，将自动使用「你的用户名 的房间」。&#x0a;密码留空即为公开房间，任何人都可以直接加入。" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <StackPanel>
                <Button x:Name="PrimaryAction" Content="创建" Style="{StaticResource BlockPrimaryButton}"
                        Command="{Binding CreateCommand}" />
                <Button Content="取消" Style="{StaticResource BlockSecondaryButton}" Margin="0,8,0,0"
                        Click="Cancel_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
