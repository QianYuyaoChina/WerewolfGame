<!--
    ⚠ 页面与窗口的三点差别见 CreateRoomPage.xaml 顶部注释（DynamicResource / UserControl 祖先 / 无 DialogResult）。

    本页由 Views/InviteCodeWindow.xaml 原样搬迁（v2.6.0 S2 页面化，架构 §9.1）。
    邀请码文本不进 DataContext，而是由 PageFactory 通过 PageRequest.Argument 传进来 ——
    它就是一份**只读展示**，不需要视图模型（多了反而要维护一份与字符串同步的状态）。

    结构契约必须保留：CodeBox（只读、可选中、可换行）/ StatusText / PrimaryAction / NavBar / NavTitleText。

    为什么仍然「显示 + 让用户主动复制」而不是打开就自动复制：
    Windows 剪贴板是全局独占资源，被其它程序占用时 Clipboard.SetDataObject 内部会重试（约 1 秒），
    若再叠加外层重试页面会卡住几秒。打开只负责显示与全选，复制交给用户主动触发。
-->
<UserControl x:Class="ClientGUI.Views.Pages.InviteCodePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="返回" Style="{StaticResource NavIconButton}"
                            Click="Back_OnClick" ToolTip="回到打开本页的那一页" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="房间邀请码"
                           Style="{StaticResource NavTitleText}" />

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="好友粘贴后可直接进入本房间，无需再输房间密码。"
                                   Style="{StaticResource MinorText}" Margin="0,0,0,12" />

                        <TextBlock Text="邀请码（只读，可选中复制）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource FlatTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="96" Padding="10,8"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />

                        <TextBlock Text="邀请码已加密，内含服务器地址、房间号与房间密码；请只发给可信的人。"
                                   Style="{StaticResource FieldHint}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MinorText}" />
                        <TextBlock Style="{StaticResource FootnoteText}" Margin="0,12,0,0"
                                   Text="对方怎么用：打开客户端 → 登录页的「邀请码」框（或房间列表的邀请码框）粘贴本码 → 点「使用 / 加入」即可直接进房。&#x0a;复制不了时：在上方框内点击 → Ctrl+A 全选 → Ctrl+C 复制。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <StackPanel>
                <Button x:Name="PrimaryAction" Content="复制邀请码" Style="{StaticResource BlockPrimaryButton}"
                        Click="Copy_OnClick" />
                <Button Content="关闭" Style="{StaticResource BlockSecondaryButton}" Margin="0,8,0,0"
                        Click="Close_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
