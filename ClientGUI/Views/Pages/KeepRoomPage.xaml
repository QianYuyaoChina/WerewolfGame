<!--
    ⚠ 页面与窗口的三点差别见 CreateRoomPage.xaml 顶部注释（DynamicResource / UserControl 祖先 / 无 DialogResult）。

    本页由 Views/KeepRoomWindow.xaml 原样搬迁（v2.6.0 S3 页面化，架构 §9.1）。
    它是「房主独自退房」时的询问：**保留房间**还是**关闭房间**。

    语义（I6，与旧窗口逐字一致，别在这一层重写判断）：
      · 点「保留房间」→ 结果为 true；
      · 点「关闭房间」→ 结果为 false；
      · **点「取消」**（v2.6.0 S8）→ 结果为 KeepRoomChoice.Cancel
        → 连退房都不做，回到房间里继续待着（与「保留房间」不是一回事）；
      · **返回 / Esc / 外壳点 ×**（= 用户没显式选择）→ 结果为 null
        → 调用方交给 KeepRoomDecision.ResolveChoice（null ⇒ 保留）。随手关掉不该把房主的房间关掉。

    入栈方式：**PushForResultAsync 浮层**（S3 起）。下层房间页不退场 ——
    「是否保留房间」这个决定正是房间页的视图模型在回答，下层被 OnLeave 掉就会自问自答（T41 的原始事故形态）。
-->
<UserControl x:Class="ClientGUI.Views.Pages.KeepRoomPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- 返回 = 保留（I6）：与底部主按钮等价，用户在浮层里随便按一下都不会误删房间。 -->
                    <Button Content="返回" Style="{StaticResource NavIconButton}"
                            Click="Back_OnClick" ToolTip="保留房间并退出（等同于「保留房间」）" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="是否保留房间？"
                           Style="{StaticResource NavTitleText}" />

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="你是房主，且房间内已没有其他玩家。" Style="{StaticResource MinorText}"
                                   Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="保留后房间会继续出现在房间列表中（他人凭房间号 / 邀请码即可加入），一直保留到服务器关闭；不保留则立即关闭该房间。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="保留房间" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                        <TextBlock Text="房间保持可用，你和好友之后都能重新进入。"
                                   Style="{StaticResource MinorText}" Margin="0,4,0,0" />

                        <Border Style="{StaticResource DividerLine}" Margin="0,12" />

                        <TextBlock Text="关闭房间" Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}" />
                        <TextBlock Text="房间立即从列表中移除，房间号随之失效。"
                                   Style="{StaticResource MinorText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <StackPanel>
                <Button x:Name="PrimaryAction" Content="保留房间" Style="{StaticResource BlockPrimaryButton}"
                        Click="KeepRoom_OnClick" />
                <Button x:Name="CloseRoomAction" Content="关闭房间" Style="{StaticResource BlockSecondaryButton}"
                        Margin="0,8,0,0" Click="CloseRoom_OnClick" />
                <!-- 取消（v2.6.0 S8）：连退房都不做，回到房间里继续待着。
                     与「保留房间」不是一回事 —— 后者是「退房 + 房间留下」。 -->
                <Button x:Name="CancelAction" Content="取消（留在房间里）"
                        Style="{StaticResource BlockSecondaryButton}"
                        Margin="0,8,0,0" Click="Cancel_OnClick" />
                <TextBlock x:Name="KeepHintText" Text="点「取消」不退出房间；点「返回」或按 Esc 视为「保留房间」。"
                           Style="{StaticResource FootnoteText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
