<!--
    ⚠ 页面（UserControl）与窗口（Window）的两点差别，改这里时务必注意：
      1. 根元素上的 Background/Foreground 仍必须用 DynamicResource（颜色由 ThemeManager 挂在
         Application 级，静态资源在解析时看不到元素下面声明的 Resources）；
      2. 页内任何 RelativeSource 的 AncestorType 必须是 UserControl —— 原来写 Window 的绑定
         换到页面里会找不到祖先，界面会静默丢数据。

    本页由 Views/LoginWindow.xaml 原样搬迁（v2.6.0 S1 页面化，架构 §9.1）：
      Tab1「创建内置服务器」—— 在这台电脑上直接开一个服务器（默认停留）
      Tab2「连接现有服务器」—— 控件、默认值、邀请码逻辑与改造前逐项一致
    两个标签页共享用户名 / 密码与底部状态条（切页不丢输入）。

    结构契约（UiSmokeCheck）必须保留：
      · Tabs（TabControl，2 页，页头依次含「创建内置服务器」「连接现有服务器」，默认选中第 1 页）；
      · PortInput / ServerUrlInput / InviteCodeInput / UsernameInput / PasswordInput 五个命名输入框；
      · 页头必须是**字符串**（冒烟用例按 Header 文本比对）。

    Q1=B 兜底（架构 N4）：从房间列表返回本页时连接**没断**、内置服务器**还在跑**，
    此时「一键开服」主按钮的文案已经由 EmbeddedServerViewModel 切成了「进入房间列表」
    （IsOneClickDone = 已登录 + 服务器运行中），点它直接回列表，不会重复开服。
-->
<UserControl x:Class="ClientGUI.Views.Pages.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EmbeddedServerViewModel}"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Page_OnKeyDown">

    <!-- 与主窗口一样用 pack URI 定位主题，保证从任意工作目录启动都能解析。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条（状态） -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中于整条导航栏） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="狼人杀" Style="{StaticResource NavTitleText}" />
                <Button Grid.Column="2" Content="设置" Style="{StaticResource NavIconButton}" HorizontalAlignment="Right"
                        Click="Settings_OnClick" ToolTip="外观主题等设置（快捷键 Ctrl + ,）" />
            </Grid>
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <StackPanel>

                <Border Style="{StaticResource CardPanel}">
                    <TabControl x:Name="Tabs" Style="{StaticResource FlatTabControl}"
                                SelectionChanged="Tabs_OnSelectionChanged">

                        <!-- ─────────── Tab 1：创建内置服务器 ─────────── -->
                        <TabItem x:Name="EmbeddedTab" Header="创建内置服务器"
                                 DataContext="{Binding Embedded, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Margin="0,4,0,0">

                                <!-- 端口 -->
                                <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PortInput" Grid.Column="0"
                                             Style="{StaticResource FieldInput}"
                                             Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditPort}"
                                             MaxLength="5" />
                                    <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                              Content="被占用时自动换一个空闲端口"
                                              IsChecked="{Binding AllowPortDrift}"
                                              IsEnabled="{Binding CanEditPort}"
                                              Foreground="{DynamicResource TextSoftBrush}"
                                              FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding PortError}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding IsPortValid, Converter={StaticResource InverseBoolToVisibility}}" />

                                <!--
                                    一键开服（v2.5.0 第 6 条）：一次点击 = 启动服务器 + 连接 + 用内置管理员登录。
                                    就绪后同一个按钮变成「进入房间列表」，点它才真正进房。
                                    下面**不再**要求用户输入用户名 / 密码（用内置管理员，明文写在按钮下方）。
                                -->
                                <Button x:Name="EmbeddedPrimaryAction" Margin="0,16,0,0"
                                        Style="{StaticResource BlockPrimaryButton}"
                                        Content="{Binding MainButtonText}"
                                        Command="{Binding OneClickCommand}"
                                        ToolTip="启动内置服务器 → 自动连接 → 以内置管理员登录" />

                                <!-- 分步状态：卡在哪一步一眼可见（失败不回滚已启动的服务器）。 -->
                                <TextBlock x:Name="OneClickStepText" Text="{Binding StepText}"
                                           Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasStepText, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding OneClickHint}" Style="{StaticResource FootnoteText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />

                                <Button Margin="0,8,0,0" Style="{StaticResource BlockSecondaryButton}"
                                        Content="停止服务器"
                                        Command="{Binding StopCommand}" />

                                <!-- 运行信息 -->
                                <Border Margin="0,16,0,0" Padding="12" Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <!-- 状态徽章 -->
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Starting">
                                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Stopping">
                                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StateText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MinorText}"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 本机地址 -->
                                        <TextBlock Text="本机地址" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                                     Text="{Binding LocalUrlText, Mode=OneWay}"
                                                     IsReadOnly="True" FontSize="12" />
                                            <Button Grid.Column="1" Content="复制" Style="{StaticResource FlatButton}"
                                                    Padding="16,8" Margin="8,0,0,0"
                                                    Command="{Binding CopyCommand}"
                                                    CommandParameter="{Binding LocalUrlText}" />
                                        </Grid>

                                        <!-- 局域网地址 -->
                                        <TextBlock Text="局域网地址（发给朋友）" Style="{StaticResource FieldLabel}"
                                                   Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                                     Text="{Binding LanUrlText, Mode=OneWay}"
                                                     IsReadOnly="True" FontSize="12" />
                                            <Button Grid.Column="1" Content="复制" Style="{StaticResource FlatButton}"
                                                    Padding="16,8" Margin="8,0,0,0"
                                                    Command="{Binding CopyCommand}"
                                                    CommandParameter="{Binding LanUrlText}" />
                                        </Grid>

                                        <!-- 端口漂移提示 / 工作目录 -->
                                        <TextBlock Text="{Binding DriftNote}" Style="{StaticResource FieldError}"
                                                   Foreground="{DynamicResource WarnBrush}"
                                                   Visibility="{Binding HasDriftNote, Converter={StaticResource BoolToVisibility}}" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WorkDirectoryText}"
                                                       Style="{StaticResource FootnoteText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding WorkDirectoryText}" />
                                            <Button Grid.Column="1" Content="打开服务器目录"
                                                    Style="{StaticResource FlatButton}"
                                                    Padding="16,8" Margin="8,0,0,0" FontSize="12"
                                                    Command="{Binding OpenDirectoryCommand}"
                                                    ToolTip="打开配置 / 账号 / 词库所在的目录" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!--
                                    v2.5.0：这里**不再**要求输入用户名 / 密码 ——
                                    一键开服用的是内置管理员账号（界面上已明文标注用谁登录）。
                                    想用自己的账号，请切到「连接现有服务器」页。
                                -->
                            </StackPanel>
                        </TabItem>

                        <!-- ─────────── Tab 2：连接现有服务器（与改造前逐项一致） ─────────── -->
                        <TabItem x:Name="ExternalTab" Header="连接现有服务器"
                                 DataContext="{Binding Login, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ServerUrlInput" Style="{StaticResource FieldInput}"
                                         Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}" />

                                <!--
                                    邀请码：粘贴好友分享的码后点「使用」，会自动填好上面的服务器地址，
                                    登录成功后直接进入该房间（房间密码由邀请码携带，无需手动输入）。
                                -->
                                <TextBlock Text="邀请码（可选）" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InviteCodeInput" Grid.Column="0" Style="{StaticResource FieldInput}"
                                             Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsIdle}" />
                                    <Button Grid.Column="1" Content="使用邀请码" Style="{StaticResource FlatButton}"
                                            Padding="16,8" Margin="8,0,0,0"
                                            Command="{Binding UseInviteCommand}"
                                            IsEnabled="{Binding IsIdle}" />
                                </Grid>
                                <TextBlock Text="{Binding InviteHint}" Style="{StaticResource FieldError}"
                                           Foreground="{DynamicResource OkBrush}"
                                           Visibility="{Binding HasInviteHint, Converter={StaticResource BoolToVisibility}}" />

                                <!-- ═══════════════ 用户名 ═══════════════ -->
                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                <TextBox x:Name="UsernameInput" Style="{StaticResource FieldInput}"
                                         Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsIdle}"
                                         MaxLength="20" />

                                <!-- ═══════════════ 密码 ═══════════════ -->
                                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPassword}"
                                             IsEnabled="{Binding IsIdle}"
                                             PasswordChanged="PasswordInput_OnPasswordChanged" />

                                <!-- ═══════════════ 登录按钮（通栏主按钮） ═══════════════ -->
                                <Button x:Name="PrimaryAction" Margin="0,16,0,0"
                                        Style="{StaticResource BlockPrimaryButton}"
                                        Content="登录 / 注册"
                                        Command="{Binding LoginCommand}"
                                        IsEnabled="{Binding IsIdle}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <TextBlock Style="{StaticResource FootnoteText}"
                               Text="内置服务器只在这台电脑上跑，关掉客户端会一起关掉；想让同网络的朋友加入，把上面的局域网地址发给他即可（首次监听若弹出防火墙提示，请选择允许）。&#x0a;首次登录的用户名会自动注册；掉线后用相同的用户名 + 密码重新登录即可恢复原房间身份。&#x0a;默认地址 http://localhost:5000/gamehub（快速幂协商密钥 + 会话加密）" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条（共享状态） ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <!--
                文字颜色交给样式 + DataTrigger；不要在元素上直接写 Foreground，
                本地值优先级高于样式触发器，会让“失败标红”失效。
            -->
            <TextBlock Text="{Binding Login.Status, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MinorText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Login.ShowError, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
