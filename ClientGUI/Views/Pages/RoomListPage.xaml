<!--
    注意：页面根元素上的 Background/Foreground 必须用 DynamicResource；
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。
    页内 RelativeSource 的 AncestorType 一律是 UserControl（原来写 Window 的绑定会失效）。

    本页由 Views/RoomListWindow.xaml 原样搬迁（v2.6.0 S1 页面化，架构 §9.1）。
    v2.5.0 小程序骨架：导航栏 56（居中标题 + 左右各 ≥44 热区）+ 灰底上的白色卡片内容区 + 底部通栏主按钮。
    导航栏标题做成 Button（透明底、居中、≥44×44）—— 它就是「房间列表」彩蛋的热区（K12），
    3 秒 5 击的计数接在这个按钮的 PreviewMouseLeftButtonDown 上（B3）。

    彩蛋输入框是**页面内浮层**（OverlayDialog），叠在整页之上；它不是 Window 子类，
    因此不会扩大 UI 冒烟的结构契约（架构 K11 / D3-C2）。

    v2.6.0 S1 的唯一结构变化（Q1=B，架构 N4）：左槽位最前面多一个「返回」按钮 ——
    回登录页是**纯导航**，不断连接、不停内置服务器。导航栏仍是 *|Auto|* 三列，
    标题依旧几何居中（I5），因此既有的居中实测断言一条都不用改。
-->
<UserControl x:Class="ClientGUI.Views.Pages.RoomListPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:ClientGUI.Controls"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RoomListViewModel}"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Page_OnKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 外层只做一件事：让彩蛋浮层能盖住整页（与手机端「页面内弹层」一致）。 -->
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 导航栏 -->
                <RowDefinition Height="*" />     <!-- 卡片内容区 -->
                <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
            </Grid.RowDefinitions>

            <!-- ═══════════════ 导航栏（*|Auto|* 三列：标题几何居中于整条导航栏） ═══════════════ -->
            <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Q1=B：回登录页是纯导航（不断连接、不停服务器），换账号 / 看地址都靠它。 -->
                        <Button Content="返回" Style="{StaticResource NavIconButton}"
                                Click="Back_OnClick" ToolTip="回到登录页（不会断开连接，也不会停内置服务器）" />

                        <Button Content="刷新" Style="{StaticResource NavIconButton}" Margin="4,0,0,0"
                                Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"
                                ToolTip="重新拉取房间列表" />

                        <!--
                            服务器运行胶囊（PRD 8.6）：退出房间 / 关主窗口都不停内置服务器，
                            回到房间列表时要能一眼看出它还在跑。
                            *|Auto|* 三列下标题恒居中（两侧等分），往左槽位加内容不会再推偏标题。
                        -->
                        <Border Style="{StaticResource StatusChipBorder}" Margin="8,0,0,0"
                                Visibility="{Binding IsEmbeddedServerRunning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EmbeddedServerText}" Style="{StaticResource ChipText}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- 居中标题 = 彩蛋热区：3 秒内点 5 下触发（未达成静默清零） -->
                    <Button Grid.Column="1" x:Name="NavTitleButton" Content="房间列表"
                            Style="{StaticResource NavTitleButton}"
                            PreviewMouseLeftButtonDown="NavTitle_OnPreviewMouseLeftButtonDown" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="创建房间" Style="{StaticResource NavIconButton}"
                                Click="CreateRoom_OnClick" IsEnabled="{Binding IsIdle}" />
                        <Button Content="设置" Style="{StaticResource NavIconButton}" Margin="4,0,0,0"
                                Click="Settings_OnClick" ToolTip="设置（快捷键 Ctrl + ,）" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ 内容区 ═══════════════ -->
            <Grid Grid.Row="1" Margin="12,12,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 邀请码卡片 -->
                    <RowDefinition Height="*" />     <!-- 房间列表卡片 -->
                    <RowDefinition Height="Auto" />  <!-- 已选 + 密码卡片 -->
                </Grid.RowDefinitions>

                <!-- 邀请码 -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="邀请码" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InviteCodeInput" Grid.Column="0" Style="{StaticResource FieldInput}"
                                     Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsIdle}" />
                            <Button Grid.Column="1" Content="加入" Style="{StaticResource FlatButton}"
                                    Padding="24,8" Margin="8,0,0,0"
                                    Command="{Binding UseInviteCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 房间列表 -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 列头 -->
                            <RowDefinition Height="*" />     <!-- 列表 -->
                        </Grid.RowDefinitions>

                        <!-- 列头 -->
                        <Grid Grid.Row="0" Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="房间号" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="游戏" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="房间名" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="人数" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="加密" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="房主" Style="{StaticResource MinorText}" FontWeight="SemiBold" />
                        </Grid>
                        <Border Grid.Row="0" Style="{StaticResource DividerLine}" VerticalAlignment="Bottom" Margin="0" />

                        <!-- 列表 -->
                        <Grid Grid.Row="1">
                            <ListBox x:Name="RoomList"
                                     ItemsSource="{Binding Rooms}"
                                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Padding="0" Margin="0,0,0,8">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            BorderBrush="Transparent" BorderThickness="0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardAltBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardAltBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoomRow}">
                                        <!-- 行高 ≥56，整行可点；分隔线 1px 且与文字左对齐（靠 ListRow 的 Padding 16）。 -->
                                        <Border Style="{StaticResource ListRow}" MinHeight="56">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="84" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSoftBrush}"
                                                               VerticalAlignment="Center" />
                                                    <!-- 「游戏」列用小胶囊 + 游戏主题色：不同游戏的房间在列表里就能一眼分开。 -->
                                                    <Border Grid.Column="1" CornerRadius="999" Padding="8,2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            BorderThickness="1"
                                                            BorderBrush="{Binding GameAccent, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding GameText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding GameAccent, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="12"
                                                               Foreground="{DynamicResource PhaseBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding LockText}" FontSize="12"
                                                               Foreground="{DynamicResource PrivateBrush}"
                                                               VerticalAlignment="Center" />

                                                    <!-- 房主列：名字后面跟一枚金色称号胶囊（无称号时不渲染）。 -->
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HostText}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <controls:TitleChip Text="{Binding HostTitle}"
                                                                            Margin="6,0,0,0"
                                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Grid.Row="1" Style="{StaticResource DividerLine}" Margin="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空态提示（不用 DataTrigger 监听 Count，避免测量递归） -->
                            <TextBlock Text="暂无房间，点击右上角「创建房间」开一局吧。"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource MinorText}"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 已选 + 密码 -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="已选房间" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource BodyText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="密码（加密房间必填）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPassword}"
                                     IsEnabled="{Binding IsPasswordEnabled}"
                                     PasswordChanged="PasswordInput_OnPasswordChanged" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════ 底部操作条 ═══════════════ -->
            <Border Grid.Row="2" Style="{StaticResource FooterBar}">
                <StackPanel>
                    <Button x:Name="PrimaryAction" Content="加入房间" Style="{StaticResource BlockPrimaryButton}"
                            Command="{Binding JoinCommand}" />
                    <TextBlock Text="{Binding Status}" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MinorText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ 彩蛋浮层（默认收起） ═══════════════ -->
        <controls:OverlayDialog x:Name="EggOverlay" Visibility="Collapsed"
                                PrimaryClick="EggOverlay_OnPrimaryClick"
                                SecondaryClick="EggOverlay_OnSecondaryClick" />
    </Grid>
</UserControl>
