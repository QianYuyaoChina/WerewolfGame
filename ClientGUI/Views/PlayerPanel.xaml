<UserControl x:Class="ClientGUI.Views.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ClientGUI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        左栏（宿主）：玩家列表 + 房主开始按钮。
        「我的身份」等玩法展示由插槽面板（如 WerewolfPanel）负责，宿主保持游戏无关。
    -->
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 玩家列表标题 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="玩家列表" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="点击玩家可选择目标" FontSize="10.5" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource FaintBrush}" />
            </Grid>

            <!-- 玩家列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="PlayerList"
                         ItemsSource="{Binding Players}"
                         ItemTemplate="{StaticResource PlayerRowTemplate}"
                         Style="{StaticResource PlayerListBox}"
                         SelectionChanged="PlayerList_OnSelectionChanged" />
            </ScrollViewer>

            <!-- 开始按钮 / 提示 -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Content="🎬 开始游戏" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartGameCommand}"
                        IsEnabled="{Binding CanStartGame}"
                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StartHint}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ShowStartHint, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
