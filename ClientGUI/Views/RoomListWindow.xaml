<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。
-->
<Window x:Class="ClientGUI.Views.RoomListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:ClientGUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RoomListViewModel}"
        Title="狼人杀 · 房间列表"
        Height="600" Width="820" MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题 + 工具按钮 -->
            <RowDefinition Height="Auto" />  <!-- 列头 -->
            <RowDefinition Height="*" />     <!-- 列表 -->
            <RowDefinition Height="Auto" />  <!-- 选中 + 密码 + 加入 -->
            <RowDefinition Height="Auto" />  <!-- 状态 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 + 工具按钮 ═══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🐺" FontSize="20" VerticalAlignment="Center" />
                <TextBlock Text="房间列表" FontSize="17" FontWeight="Bold" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="选择一个房间加入，或创建新房间" FontSize="12" Margin="12,2,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Style="{StaticResource FlatButton}" Padding="14,7" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="创建房间" Style="{StaticResource PrimaryButton}" Padding="14,7"
                        Click="CreateRoom_OnClick" IsEnabled="{Binding IsIdle}" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════ 列头 ═══════════════ -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="128" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="房间号" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="房间名" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="人数" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="加密" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="房主" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- ═══════════════ 列表 ═══════════════ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <ListBox x:Name="RoomList"
                     ItemsSource="{Binding Rooms}"
                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,10"
                                            BorderBrush="Transparent" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoomRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFCFDAEC" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis" Foreground="#FFE8EDF6"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12.5"
                                       Foreground="#FF8D9AB2" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12.5"
                                       Foreground="#FFB79CFF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding LockText}" FontSize="12.5"
                                       Foreground="#FFFFCE6B" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{Binding HostText}" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" Foreground="#FF8D9AB2"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态提示（不用 DataTrigger 监听 Count，避免测量递归） -->
            <TextBlock Text="暂无房间，点击「创建房间」开一局吧。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ═══════════════ 选中 + 密码 + 加入 ═══════════════ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding SelectionText}" FontSize="12.5"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="密码" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="12,0,8,0" />

                <PasswordBox x:Name="PasswordInput" Grid.Column="2"
                             Style="{StaticResource FlatPasswordBox}"
                             IsEnabled="{Binding IsPasswordEnabled}"
                             PasswordChanged="PasswordInput_OnPasswordChanged" />

                <Button Grid.Column="3" Content="加入房间" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Margin="12,0,0,0"
                        Command="{Binding JoinCommand}" />
            </Grid>
        </Border>

        <!-- ═══════════════ 状态 ═══════════════ -->
        <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="6"
                Padding="12,9" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
