<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。
-->
<Window x:Class="ClientGUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="设置"
        Height="486" Width="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 标题 -->
            <RowDefinition Height="*" />     <!-- 标签页 -->
            <RowDefinition Height="Auto" />  <!-- 提示 + 按钮 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 标题 ═══════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource CardBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="CurrentThemeText" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════ 标签页 ═══════════════ -->
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource FlatTabControl}">

            <!-- ─────────── 外观 ─────────── -->
            <TabItem Header="外观">
                <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />
                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Tag="System"
                                 Content="跟随系统（与 Windows 的应用模式一致）"
                                 Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                 Checked="Theme_OnChecked" />
                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Tag="Light"
                                 Content="浅色" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0"
                                 Checked="Theme_OnChecked" />
                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Tag="Dark"
                                 Content="深色" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0"
                                 Checked="Theme_OnChecked" />
                    <TextBlock Text="选择后立即生效，并记住到下次启动。"
                               FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />
                </StackPanel>
            </TabItem>

            <!-- ─────────── 主界面 ─────────── -->
            <TabItem Header="主界面">
                <StackPanel>
                    <TextBlock Text="显示哪些面板" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="ShowPlayers" Content="玩家列表"
                              Foreground="{DynamicResource TextBrush}"
                              Checked="View_OnChanged" Unchecked="View_OnChanged" />
                    <CheckBox x:Name="ShowChat" Content="房间消息" Margin="0,12,0,0"
                              Foreground="{DynamicResource TextBrush}"
                              Checked="View_OnChanged" Unchecked="View_OnChanged" />
                    <CheckBox x:Name="ShowActions" Content="操作面板" Margin="0,12,0,0"
                              Foreground="{DynamicResource TextBrush}"
                              Checked="View_OnChanged" Unchecked="View_OnChanged" />
                    <TextBlock Text="这三项与主窗口「视图」菜单联动，改动会立即生效并记住。"
                               FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />
                </StackPanel>
            </TabItem>

            <!-- ─────────── 上次使用 ─────────── -->
            <TabItem Header="上次使用">
                <StackPanel>
                    <TextBlock Text="自动回填的信息" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="ServerText" Grid.Row="0" Grid.Column="1" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名" Margin="0,10,0,0"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="UserText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                   FontSize="12.5" Foreground="{DynamicResource TextBrush}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="房间号" Margin="0,10,0,0"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="RoomText" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                                   FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                    </Grid>
                    <TextBlock Text="只用于下次自动回填，不保存密码。"
                               FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource FaintBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ 提示 + 按钮 ═══════════════ -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource FaintBrush}"
                       Text="设置可在任意界面打开：按 Ctrl + , 即可（登录界面、房间列表、主窗口都能用）。" />

            <Grid Grid.Row="1">
                <Button Content="恢复默认设置" Style="{StaticResource FlatButton}" Padding="16,8"
                        HorizontalAlignment="Left" Click="Reset_OnClick" />
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        HorizontalAlignment="Right" Click="Close_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
