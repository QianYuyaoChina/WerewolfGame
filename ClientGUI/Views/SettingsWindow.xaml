<!--
    注意：窗口根元素上的 Foreground/Background 必须用 DynamicResource。
    静态资源在解析这两个属性时还看不到本元素下面声明的 Resources。

    v2.5.0 小程序骨架：导航栏 56（居中标题）+ 灰底上的白色卡片内容区 + 通栏底部主按钮。
    结构契约（UiSmokeCheck）：Tabs 必须仍是 TabControl、4 页、页头依次是
    外观 / 主界面 / 上次使用 / 账号设置，且页头必须是**字符串**（冒烟用例按 Header.ToString() 比对）；
    ThemeDark / ThemeLight / ShowChat / ShowPlayers / ShowActions / ServerText 一个都不能少。

    v2.5.0 第 5 / 7 条（用户裁定）：修改密码 / 服务器设置的入口放在**本窗口**，不再新增顶级「账号」菜单。
    收尾轮追加：这两项不再放在标签页下方的卡片里，而是收进**独立的第 4 个标签页「账号设置」**，按会话身份显隐：
      · 「修改密码…」登录后可用；
      · 「服务器设置…」仅管理员可见（服务端仍会二次校验，客户端只做显隐）。
    两个浮层正文都塞进 OverlayDialog（K11），浮层仍挂在窗口层（不在标签页里），不新增 Window 子类。
-->
<Window x:Class="ClientGUI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:ClientGUI.Controls"
        mc:Ignorable="d"
        Title="设置"
        Height="614" Width="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ClientGUI;component/Themes/Panels.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 导航栏 -->
            <RowDefinition Height="*" />     <!-- 卡片内容区 -->
            <RowDefinition Height="Auto" />  <!-- 底部操作条 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ 导航栏（居中标题：*|Auto|* 三列，标题几何居中） ═══════════════ -->
        <Border x:Name="NavBar" Grid.Row="0" Style="{StaticResource NavBarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左槽位留空（本窗口没有左入口）。 -->
                <TextBlock Grid.Column="1" x:Name="NavTitleText" Text="设置"
                           Style="{StaticResource NavTitleText}" />

                <TextBlock Grid.Column="2" x:Name="CurrentThemeText" Style="{StaticResource MinorText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════ 内容区 ═══════════════ -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Margin="12,12,12,0">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource FlatTabControl}">

                        <!-- ─────────── 外观 ─────────── -->
                        <TabItem Header="外观">
                            <StackPanel>
                                <TextBlock Text="主题" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Tag="System"
                                             Content="跟随系统（与 Windows 的应用模式一致）"
                                             Foreground="{DynamicResource TextBrush}"
                                             Checked="Theme_OnChecked" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Tag="Light"
                                             Content="浅色" Foreground="{DynamicResource TextBrush}"
                                             Margin="0,12,0,0"
                                             Checked="Theme_OnChecked" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Tag="Dark"
                                             Content="深色" Foreground="{DynamicResource TextBrush}"
                                             Margin="0,12,0,0"
                                             Checked="Theme_OnChecked" />
                                <TextBlock Text="选择后立即生效，并记住到下次启动。"
                                           Style="{StaticResource FieldHint}" Margin="0,16,0,0" />
                            </StackPanel>
                        </TabItem>

                        <!-- ─────────── 主界面 ─────────── -->
                        <TabItem Header="主界面">
                            <StackPanel>
                                <TextBlock Text="显示哪些面板" Style="{StaticResource SectionTitleText}"
                                           Margin="0,0,0,12" />
                                <CheckBox x:Name="ShowPlayers" Content="玩家列表"
                                          Foreground="{DynamicResource TextBrush}"
                                          Checked="View_OnChanged" Unchecked="View_OnChanged" />
                                <CheckBox x:Name="ShowChat" Content="房间消息" Margin="0,12,0,0"
                                          Foreground="{DynamicResource TextBrush}"
                                          Checked="View_OnChanged" Unchecked="View_OnChanged" />
                                <CheckBox x:Name="ShowActions" Content="操作面板" Margin="0,12,0,0"
                                          Foreground="{DynamicResource TextBrush}"
                                          Checked="View_OnChanged" Unchecked="View_OnChanged" />
                                <TextBlock Text="这三项与主窗口「视图」菜单联动，改动会立即生效并记住。"
                                           Style="{StaticResource FieldHint}" Margin="0,16,0,0" />
                            </StackPanel>
                        </TabItem>

                        <!-- ─────────── 上次使用 ─────────── -->
                        <TabItem Header="上次使用">
                            <StackPanel>
                                <TextBlock Text="自动回填的信息" Style="{StaticResource SectionTitleText}"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ServerText" Style="{StaticResource BodyText}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                <TextBlock x:Name="UserText" Style="{StaticResource BodyText}" />

                                <TextBlock Text="房间号" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                <TextBlock x:Name="RoomText" Style="{StaticResource BodyText}" />

                                <TextBlock Text="只用于下次自动回填，不保存密码。"
                                           Style="{StaticResource FieldHint}" Margin="0,16,0,0" />
                            </StackPanel>
                        </TabItem>

                        <!-- ─────────── 账号设置（v2.5.0 第 5 / 7 条 · 收尾轮改为独立标签页） ─────────── -->
                        <TabItem Header="账号设置">
                            <StackPanel>
                                <TextBlock Text="账号" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />

                                <Button x:Name="ChangePasswordButton" Content="修改密码…"
                                        Style="{StaticResource BlockSecondaryButton}"
                                        Click="ChangePassword_OnClick" />

                                <TextBlock x:Name="AccountHint" Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Text="登录后可以在这里修改密码；管理员还能远程编辑服务器上的数据资源。" />

                                <!-- 仅管理员可见（服务端仍会二次校验，客户端只做显隐）。 -->
                                <Button x:Name="ServerSettingsButton" Content="服务器设置…"
                                        Style="{StaticResource BlockSecondaryButton}"
                                        Margin="0,8,0,0" Visibility="Collapsed"
                                        Click="ServerSettings_OnClick" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部操作条 ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <StackPanel>
                <Button x:Name="PrimaryAction" Content="关闭" Style="{StaticResource BlockPrimaryButton}"
                        Click="Close_OnClick" />
                <Button Content="恢复默认设置" Style="{StaticResource BlockSecondaryButton}" Margin="0,8,0,0"
                        Click="Reset_OnClick" />
                <TextBlock Text="设置可在任意界面打开：按 Ctrl + , 即可（登录界面、房间列表、主窗口都能用）。"
                           Style="{StaticResource FootnoteText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════════ 账号浮层（默认收起；承载修改密码 / 服务器设置两个正文） ═══════════════ -->
        <controls:OverlayDialog x:Name="AccountOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                                PrimaryClick="AccountOverlay_OnPrimaryClick"
                                SecondaryClick="AccountOverlay_OnSecondaryClick" />
    </Grid>
</Window>
